# sdlc-harness MCP server — environment variables
# From the repository root: install -m 600 bob-kit/mcp-server/.env.example .env
# The repository-root .env is gitignored — NEVER commit it.

# ── Required ────────────────────────────────────────────────────────────────

# Full URL of your GitLab instance (no trailing slash)
GITLAB_HOST=https://gitlab.example.com

# GitLab project path or numeric ID
GITLAB_PROJECT=sdlc-harness/weather-dashboard

# GitLab Personal Access Token with api scope
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ── Optional ────────────────────────────────────────────────────────────────

# Defaults to the repository-root .env; override only for a custom location.
# SDLC_ENV_FILE=/absolute/path/to/.env

# Enable verbose debug output to stderr (true | 1)
# SDLC_DEBUG=false

# Set to "true" to run live GitLab checks in the smoke test
# SDLC_SMOKE_LIVE=false
