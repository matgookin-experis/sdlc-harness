{
  "name": "sdlc-harness-skill",
  "version": "0.1.0",
  "description": "sdlc-harness Bob skill — agents, review interface, and telemetry",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "sdlc-harness": "dist/src/cli.js",
    "sdlc-harness-review": "dist/src/cli.js"
  },
  "scripts": {
    "install:skill": "bash ./install.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "cli": "node dist/src/cli.js",
    "review": "node dist/src/cli.js",
    "test:live": "node dist/src/live-review-smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  }
}
