# gitlab-local/.env.example
# Copy this file to gitlab-local/.env and set a strong password.
# The .env file is gitignored — never commit it.
#
# Usage:
#   cp .env.example .env
#   # Edit .env and set GITLAB_ROOT_PASSWORD
#   docker compose up -d

# Root password for the local GitLab instance.
# Also used as the demo user's password by seed.sh.
GITLAB_ROOT_PASSWORD=change_me_before_starting
