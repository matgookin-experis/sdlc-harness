# gitlab-local/.env.example
# Copy this file to gitlab-local/.env and set a strong password.
# The .env file is gitignored — never commit it.
#
# Usage:
#   cp .env.example .env
#   # Edit .env and set GITLAB_ROOT_PASSWORD
#   docker compose up -d

# Root password for the local GitLab instance.
# Also used as the demo user's password by seed.sh.
# Minimum 8 characters. Do NOT use a '$' in the password: Docker Compose
# treats it as variable interpolation and the container receives a
# different (or empty) password than the one written here.
GITLAB_ROOT_PASSWORD=change_me_before_starting

# Host port for the weather-app demo site (nginx).
# Change this if 8081 is already taken — on macOS, Docker Desktop's own
# helper process binds 8081 on some installs, which stops the container
# from starting at all.
DEMO_SITE_PORT=8081
