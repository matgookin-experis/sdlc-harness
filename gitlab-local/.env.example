# gitlab-local/.env.example
# Copy this file to gitlab-local/.env and set two strong passwords.
# The .env file is gitignored — never commit it.
#
# Usage:
#   install -m 600 .env.example .env
#   # Edit .env and replace both password placeholders
#   ./manage.sh start

# Root password for the local GitLab instance.
# Minimum 8 characters. Keep the single quotes when a value contains '$'
# so Docker Compose treats the value literally.
GITLAB_ROOT_PASSWORD='change_me_before_starting'

# Password for the seeded non-admin demo account. This value is required
# explicitly and is never inherited from GITLAB_ROOT_PASSWORD.
GITLAB_DEMO_PASSWORD='change_me_before_seeding'

# Host port for the weather-app demo site (nginx).
# Change this if 8081 is already taken — on macOS, Docker Desktop's own
# helper process binds 8081 on some installs, which stops the container
# from starting at all.
DEMO_SITE_PORT=8081

# Advanced migration override only. Leave unset for new installations so the
# tested digest in docker-compose.yml is used. See README.md before changing.
# GITLAB_IMAGE=gitlab/gitlab-ce:<approved-upgrade-stop>
