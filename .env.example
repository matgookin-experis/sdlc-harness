# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT


# ============================================
# sdlc-harness MCP server (GitLab) credentials
# ============================================
# This same .env file is also read by Bob's sdlc-harness MCP server
# (bob-kit/mcp-server/), via SDLC_ENV_FILE set in ~/.bob/settings/mcp.json
# after running bash bob-kit/mcp-server/install.sh. See README.md /
# bob-kit/mcp-server/.env.example for details -- these are filled in as a
# later setup step, not required for the WatsonX vars above.

# Full URL of your local GitLab instance (no trailing slash)
GITLAB_HOST=http://localhost:8080

# GitLab project path being governed
GITLAB_PROJECT=sdlc-harness/weather-dashboard

# GitLab Personal Access Token with api scope
# (./gitlab-local/manage.sh refresh-token creates and writes one here for you)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx


# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================