# sdlc-harness MCP server credentials
#
# Create the private runtime file without granting group/world access:
#   install -m 600 .env.example .env
#
# Replace the token placeholder before starting Bob. Never commit `.env`.

# Full URL of the local GitLab instance (no trailing slash)
GITLAB_HOST=http://localhost:8080

# GitLab project path governed by the skill
GITLAB_PROJECT=sdlc-harness/weather-dashboard

# Demo-user Personal Access Token with api scope
# (`./gitlab-local/manage.sh refresh-token` creates and writes one here.)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Set true only while diagnosing local MCP behavior.
SDLC_DEBUG=false
